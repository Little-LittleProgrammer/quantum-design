{
    "name": "qm-monorepo",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "turbo run build",
        "build:lib": "turbo run build:lib",
        "dev": "turbo run dev",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "test": "turbo run test",
        "test:coverage": "turbo run test:coverage",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "commit": "czg",
        "prepare": "husky"
    },
    "devDependencies": {
        "@quantum-design-configs/commitlint": "catalog:",
        "@quantum-design-configs/oxlint": "catalog:",
        "@quantum-design-configs/prettier": "catalog:",
        "@quantum-design-configs/tailwind": "catalog:",
        "@quantum-design-configs/tsconfig": "catalog:",
        "@types/node": "catalog:",
        "@vitejs/plugin-vue": "catalog:",
        "@vitejs/plugin-vue-jsx": "catalog:",
        "@vitest/ui": "catalog:",
        "husky": "catalog:",
        "jsdom": "catalog:",
        "lint-staged": "catalog:",
        "oxlint": "catalog:",
        "tslib": "catalog:",
        "turbo": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "engines": {
        "npm": ">=9.0.0",
        "node": ">=22.19.0"
    },
    "packageManager": "pnpm@10.15.1",
    "volta": {
        "node": "22.19.0",
        "pnpm": "10.15.1"
    },
    "pnpm": {
        "peerDependencyRules": {
            "allowedVersions": {
                "oxlint": "*"
            }
        },
        "overrides": {
            "oxlint": "catalog:",
            "typescript": "catalog:",
            "vite": "catalog:"
        }
    }
}
