{
    "name": "@quantum-design/vue3-pc-ui",
    "version": "0.0.0",
    "description": "vue3-pc端组件库",
    "license": "MIT",
    "author": "Evan Wu",
    "type": "module",
    "scripts": {
        "build": "vite build && vue-tsc -p tsconfig.build.json",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "files": [
        "dist"
    ],
    "main": "dist/lib/index.cjs",
    "module": "dist/es/index.js",
    "typings": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/es/index.js",
            "require": "./dist/lib/index.cjs"
        },
        "./es": {
            "types": "./dist/index.d.ts",
            "import": "./dist/es/index.js"
        },
        "./lib": {
            "types": "./dist/index.d.ts",
            "require": "./dist/lib/index.cjs"
        },
        "./es/*": {
            "types": "./dist/src/*.d.ts",
            "import": "./dist/es/*.js"
        },
        "./lib/*": {
            "types": "./dist/src/*.d.ts",
            "require": "./dist/lib/*.cjs"
        },
        "./*": "./*"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.com/"
    },
    "peerDependencies": {
        "vue": "^3.5.18",
        "vue-router": "^4.5.1"
    },
    "dependencies": {
        "@quantum-design/shared": "~3.0.0",
        "@quantum-design/utils": "~3.0.0"
    },
    "devDependencies": {
        "@changesets/cli": "^2.29.5",
        "@quantum-design-configs/oxlint": "~3.0.0",
        "@quantum-design-configs/prettier": "~3.0.0",
        "@quantum-design-configs/tailwind": "~3.0.0",
        "@quantum-design-configs/tsconfig": "~3.0.0",
        "@quantum-design-configs/vite": "^4.0.0",
        "@quantum-design/types": "~3.0.0",
        "@types/node": "^22.19.0",
        "@vue/test-utils": "^2.4.6",
        "oxlint": "^1.11.1",
        "sass": "^1.83.0",
        "rolldown": "1.2.0",
        "tslib": "^2.8.1",
        "typescript": "^5.9.2",
        "vite": "^8.1.5",
        "vue": "^3.5.18",
        "vue-router": "^4.5.1",
        "vue-tsc": "^3.0.5"
    }
}
