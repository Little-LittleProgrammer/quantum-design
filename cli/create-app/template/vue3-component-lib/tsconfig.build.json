{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "noCheck": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["src", "index.ts", "node_modules/@quantum-design/types/**/*.d.ts"],
  "exclude": ["dist", "__tests__", "**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"]
}
