{
    "name": "qm-workflow",
    "version": "0.0.6",
    "description": "工作流 cli",
    "keywords": [],
    "license": "ISC",
    "author": "Evan Wu",
    "type": "module",
    "scripts": {
        "dev": "rolldown -c -w",
        "build": "rolldown -c"
    },
    "files": [
        "README.md",
        "dist",
        "index.js",
        "tools.js"
    ],
    "bin": {
        "qm-workflow": "index.js",
        "qw": "index.js"
    },
    "exports": {
        ".": {
            "import": "./dist/tools.mjs",
            "require": "./tools.js"
        },
        "./index.js": {
            "import": "./dist/tools.mjs",
            "require": "./tools.js"
        },
        "./dist/*": "./dist/*"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.com/",
        "access": "public"
    },
    "dependencies": {
        "@larksuiteoapi/node-sdk": "catalog:",
        "axios": "catalog:",
        "dotenv": "catalog:"
    },
    "devDependencies": {
        "@types/fs-extra": "catalog:",
        "@types/lodash-es": "catalog:",
        "@types/minimist": "catalog:",
        "@types/prompts": "catalog:",
        "fs-extra": "catalog:",
        "kolorist": "catalog:",
        "lodash-es": "catalog:",
        "minimist": "catalog:",
        "prompts": "catalog:",
        "@quantum-design-configs/rolldown": "workspace:*",
        "rolldown": "catalog:"
    }
}
