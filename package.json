{
    "name": "qm-monorepo",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "turbo run build",
        "build:lib": "turbo run build:lib",
        "dev": "turbo run dev",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "test:unit": "vitest run --dom",
        "test:coverage": "turbo run test:coverage",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "commit": "czg",
        "prepare": "husky",
        "migrator": "sass-migrator module packages/**/*.scss",
        "postinstall": "turbo run stub",
        "tauri": "turbo run tauri",
        "tauri:dev": "turbo run tauri:dev",
        "tauri:build": "turbo run tauri:build"
    },
    "devDependencies": {
        "@changesets/cli": "^2.29.5",
        "@quantum-design-configs/commitlint": "workspace:*",
        "@quantum-design-configs/oxlint": "workspace:*",
        "@quantum-design-configs/prettier": "workspace:*",
        "@quantum-design-configs/tailwind": "workspace:*",
        "@quantum-design-configs/tsconfig": "workspace:*",
        "@types/node": "catalog:",
        "@vitejs/plugin-vue": "catalog:",
        "@vitejs/plugin-vue-jsx": "catalog:",
        "@vitest/ui": "catalog:",
        "@vue/test-utils": "catalog:",
        "happy-dom": "catalog:",
        "husky": "catalog:",
        "lint-staged": "catalog:",
        "oxlint": "catalog:",
        "sass-migrator": "catalog:",
        "tslib": "catalog:",
        "turbo": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "engines": {
        "npm": ">=9.0.0",
        "node": ">=22.19.0"
    },
    "packageManager": "pnpm@10.15.1",
    "volta": {
        "node": "22.19.0",
        "pnpm": "10.15.1"
    },
    "pnpm": {
        "peerDependencyRules": {
            "allowedVersions": {
                "oxlint": "*"
            }
        },
        "neverBuiltDependencies": [
            "canvas",
            "node-gyp"
        ],
        "overrides": {
            "@types/node": "catalog:",
            "oxlint": "catalog:",
            "rolldown": "catalog:",
            "typescript": "catalog:",
            "vite": "catalog:"
        }
    }
}
