# 基础镜像
FROM --platform=linux/amd64 node:22.19-alpine3.22

# 设置默认命令
CMD ["/bin/sh"]

# 安装基础工具和设置时区
RUN apk update && apk --no-cache add \
    ca-certificates \
    tzdata \
    jq \
    bash \
    make \
    coreutils \
    curl \
    git && \
    ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone

# 安装 Chromium 和必要的依赖
RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    freetype-dev \
    harfbuzz \
    ttf-freefont

# 设置 Chromium 相关环境变量
ENV CHROME_PATH=/usr/bin/chromium-browser
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV CHROMIUM_FLAGS="--no-sandbox --headless --disable-gpu"

# 配置 npm 源并安装全局依赖
RUN npm config set registry=https://packages.aliyun.com/5f6426fcdb0493ecef9118ab/npm/npm-registry/ && \
    npm config set //packages.aliyun.com/5f6426fcdb0493ecef9118ab/npm/npm-registry/:_authToken=8189340c-e582-4d1d-9f9f-1cb14eb832ee && \
    npm install -g pnpm && \
    npm install -g @anthropic-ai/claude-code

# 设置 Claude API 环境变量
ENV ANTHROPIC_BASE_URL="https://dashscope.aliyuncs.com/api/v2/apps/claude-code-proxy"
ENV ANTHROPIC_AUTH_TOKEN="sk-3e88c5f288ca46eea89c6843c095dbdc"
ENV ANTHROPIC_MODEL="claude-4.1-opus"

# 配置 Claude MCP 工具
RUN claude mcp add-json lighthouse '{"command":"npx","args":["-y","qm-lighthouse-mcp"]}' --scope user && \
    claude mcp add-json larkmcp '{"command":"npx","args":["-y","@larksuiteoapi/lark-mcp","mcp","-a","cli_a751437852b01013","-s","Z4D2w1LK0ot96ebXzLEg7dH8Dkm86tvM","-l","zh","--token-mode","tenant_access_token"]}' --scope user

# 创建 /root/prompt 目录并写入性能优化指南
RUN mkdir -p /root/prompt

COPY ./prompt/ /root/prompt/
