{
    "name": "@quantum-design/utils",
    "version": "3.0.0",
    "description": "公共 `utils` 方法",
    "keywords": [
        "quantum",
        "monorepo",
        "utils",
        "turborepo"
    ],
    "license": "ISC",
    "author": "Evan Wu",
    "scripts": {
        "build": "rolldown -c",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "files": [
        "dist",
        "extra.js",
        "extra.mjs",
        "index.js",
        "index.mjs"
    ],
    "main": "index.js",
    "module": "dist/utils.esm.min.js",
    "typings": "dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": {
                "node": "./index.mjs",
                "default": "./dist/utils.esm.min.js"
            },
            "require": "./index.js"
        },
        "./extra": {
            "types": "./dist/types/extra.d.ts",
            "import": {
                "node": "./extra.mjs",
                "default": "./dist/extra.esm.min.js"
            },
            "require": "./extra.js"
        },
        "./dist/*": "./dist/*",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.com/",
        "access": "public"
    },
    "dependencies": {},
    "devDependencies": {
        "@quantum-design-configs/rolldown": "workspace:*",
        "@quantum-design/shared": "workspace:*",
        "@quantum-design/types": "workspace:*",
        "@types/crypto-js": "catalog:",
        "crypto-js": "catalog:",
        "fake-indexeddb": "catalog:",
        "rolldown": "catalog:"
    }
}
