{
    "name": "@quantum-design/ai-core",
    "version": "1.0.0",
    "description": "quantum design aiCore AG-UI SDK over HTTP/SSE.",
    "keywords": [
        "ag-ui",
        "ai-core",
        "sse",
        "agent"
    ],
    "license": "ISC",
    "author": "Evan Wu",
    "type": "module",
    "scripts": {
        "build": "rollup -c",
        "build:types": "tsc --emitDeclarationOnly",
        "dev": "rollup -c -w"
    },
    "files": [
        "README.md",
        "dist"
    ],
    "sideEffects": false,
    "main": "dist/ai-core.cjs.min.js",
    "module": "dist/ai-core.esm.min.js",
    "types": "dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/ai-core.esm.min.js",
            "require": "./dist/ai-core.cjs.min.js"
        }
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.com/",
        "access": "public"
    },
    "dependencies": {
        "@ag-ui/core": "catalog:"
    },
    "devDependencies": {
        "@quantum-design-configs/rollup": "workspace:*",
        "rollup": "catalog:"
    }
}
