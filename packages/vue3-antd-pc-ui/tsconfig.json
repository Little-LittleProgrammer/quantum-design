{
  "extends": "@quantum-design-configs/tsconfig/vue.json",
  "compilerOptions": {
    "isolatedModules": true,
    "noEmit": true,
    // paths 依赖 baseUrl 才能解析到本包 node_modules，避免 vue-types 被解析到 .pnpm 物理路径导致 TS2742
    "baseUrl": ".",
    "paths": {
        "@vue3-antd/*": ["./src/*"],
        "vue-types": ["./node_modules/vue-types"],
        "csstype": ["./node_modules/csstype"]
    },
  },
  "include": ["src", "index.ts", "types", "node_modules/@quantum-design/types/**/*.d.ts"],
  "exclude": ["dist"]
}
