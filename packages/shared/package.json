    "scripts": {
        "build": "rolldown -c"
    },
    "files": [
        "dist"
    ],
    "main": "index.js",
    "module": "dist/shared.esm.min.js",
    "exports": {
        "./enums": {
            "types": "./dist/types/enums/enums.d.ts",
            "import": "./dist/enums.esm.min.js",
            "require": "./dist/enums.cjs.min.js"
        },
        "./color": {
            "types": "./dist/types/color/index.d.ts",
            "import": "./dist/color.esm.min.js",
            "require": "./dist/color.cjs.min.js"
        },
        "./dist/*": "./dist/*",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.com/",
        "access": "public"
    },
    "dependencies": {
        "@ctrl/tinycolor": "catalog:",
        "theme-colors": "catalog:"
    },
    "devDependencies": {
        "@quantum-design-configs/rolldown": "workspace:*",
        "@quantum-design/types": "workspace:*",
        "rolldown": "catalog:"
