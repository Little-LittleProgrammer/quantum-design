{
    "name": "@quantum-design/vue3-pc-ui",
    "version": "3.0.0-beta.0",
    "description": "vue3-pc端组件库",
    "keywords": [
        "quantum",
        "monorepo",
        "vue3",
        "turborepo"
    ],
    "license": "MIT",
    "author": "Evan Wu",
    "type": "module",
    "scripts": {
        "build": "vite build",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "files": [
        "dist"
    ],
    "main": "dist/es/index.cjs",
    "module": "dist/es/index.js",
    "typings": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/es/index.js",
            "require": "./dist/lib/index.cjs"
        },
        "./es": {
            "types": "./dist/index.d.ts",
            "import": "./dist/es/index.js"
        },
        "./lib": {
            "types": "./dist/index.d.ts",
            "require": "./dist/lib/index.cjs"
        },
        "./es/*.js": {
            "types": "./dist/index.d.ts",
            "import": "./dist/es/*.js"
        },
        "./es/*": {
            "types": "./dist/src/*.d.ts",
            "import": "./dist/es/*.js"
        },
        "./lib/*.cjs": {
            "types": "./dist/index.d.ts",
            "require": "./dist/lib/*.cjs"
        },
        "./lib/*": {
            "types": "./dist/src/*.d.ts",
            "require": "./dist/lib/*.cjs"
        },
        "./*": "./*"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.com/",
        "access": "public"
    },
    "peerDependencies": {
        "vue": "^3.4.0",
        "vue-router": "^4.4.0"
    },
    "dependencies": {
        "@quantum-design/styles": "workspace:*",
        "@quantum-design/utils": "workspace:*"
    },
    "devDependencies": {
        "@quantum-design-configs/vite": "workspace:*",
        "@quantum-design/types": "workspace:*",
        "monaco-editor": "catalog:",
        "sass": "catalog:",
        "tinymce": "catalog:",
        "vue": "catalog:",
        "vue-router": "catalog:"
    }
}
